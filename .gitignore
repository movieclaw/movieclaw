# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.python-version
dist/
build/
.coverage
htmlcov/

# 环境变量
.env
.env.local
.env.*.local

# Node / pnpm / Next.js
node_modules/
.next/
.next-*/
out/
.pnpm-store/
*.tsbuildinfo

# JASSUB（字幕渲染）的 worker/wasm/字体：4MB 二进制，由 prebuild 钩子从
# node_modules 复制过来，不进 git（见 apps/web/scripts/copy-jassub.mjs）
apps/web/public/jassub/

# WXT 浏览器插件构建产物
apps/extension/.wxt/
apps/extension/.output/
apps/web/.env.local
apps/web/.env.production.local
apps/web/.env.development.local
apps/web/tmp/

# 编辑器与本地工具
.idea/
.vscode/
.DS_Store
.claude/settings.local.json
/.claude/launch.json
.codex/

# 运行期数据：SQLite 数据库文件及其 WAL/SHM 附属文件（部署时挂载为 volume）
/data/

# uv 生成的锁文件（项目用 pip/venv，见 scripts/dev.sh）
uv.lock

# Swift Package Manager 构建产物
macos/**/.build/

# goreleaser 打包前从仓库根复制进来的 LICENSE（构建产物，见 cli/.goreleaser.yaml）
cli/LICENSE

# OpenAPI 基线 spec 是构建产物（scripts/export-spec.sh 从代码导出），不入库：
# 单行 600KB 的生成物入库会让所有改路由的 PR 互相冲突。镜像、发版脚本、
# CI 都现场导出；本地缺失时服务端从代码现算，编译 Go CLI 前跑一次该脚本。
src/movieclaw_api/data/spec.json
cli/internal/spec/data/spec.json
